{
  "name": "trace-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TRACE research homepage and interactive humanoid demo",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "check": "node scripts/check-site.mjs",
    "check:physics": "node scripts/check-local-physics.mjs",
    "check:simulation": "node scripts/check-local-simulation.mjs",
    "check:planner": "node scripts/check-planner-bank.mjs --output qa/generated/planner-bank.json",
    "check:controls": "node scripts/check-planner-controls.mjs",
    "check:combinations": "node scripts/check-planner-combinations.mjs --output qa/generated/planner-combinations.json",
    "check:quality": "node scripts/check-planner-quality.mjs --output qa/generated/planner-quality.json",
    "check:boundaries": "node scripts/check-planner-boundaries.mjs --output qa/generated/planner-boundaries.json",
    "check:turning": "node scripts/check-planner-turn-rates.mjs --output qa/generated/planner-turn-rates.json",
    "build": "node scripts/build-site.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:release": "npm run check && npm run check:controls && npm run build && npm run check:dist",
    "check:m21": "node scripts/check-m21-parity.mjs && node scripts/check-m21-release.mjs",
    "check:parity": "node scripts/check-m21-parity.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
